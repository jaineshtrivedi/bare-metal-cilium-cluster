#!/usr/bin/env bash
# Copy to inventory.env and edit for the five Ubuntu 24.04 hosts.

SSH_USER="root"
SSH_OPTS="-o StrictHostKeyChecking=accept-new -o ServerAliveInterval=20"
ANSIBLE_SSH_COMMON_ARGS="-o StrictHostKeyChecking=accept-new -o ServerAliveInterval=20"
# SSH_PRIVATE_KEY_FILE="/absolute/path/to/id_ed25519"

# Recommended layout for five hosts: 3 control-plane nodes and 2 workers.
CP_NODES=("10.0.0.11" "10.0.0.12" "10.0.0.13")
WORKER_NODES=("10.0.0.21" "10.0.0.22")

# Fixed public NodePort used by the demo Service.
NODE_PORT="30080"

POD_CIDR="10.233.64.0/18"
SERVICE_CIDR="10.233.0.0/18"
CLUSTER_DNS_DOMAIN="cluster.local"
CLUSTER_NAME="bare-metal.local"

# Versions validated together by this repository.
KUBESPRAY_VERSION="v2.31.0"
KUBERNETES_VERSION="1.35.4"
